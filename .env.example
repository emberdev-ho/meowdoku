# MongoDB Atlas
MONGODB_URI="mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB="meowdoku"

# Upstash Redis (nếu tạo qua Vercel Marketplace thì sẽ có sẵn KV_REST_API_URL / KV_REST_API_TOKEN)
UPSTASH_REDIS_REST_URL="https://xxxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN="..."

# Chuỗi ngẫu nhiên >= 32 ký tự, tạo bằng: openssl rand -base64 48
AUTH_SECRET="..."
