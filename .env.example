# MongoDB tự quản (một mongod đơn lẻ là đủ, không cần cluster/replica set)
# Trên VPS có bật xác thực và TLS: mongodb://USER:PASS@db.example.com:27017/meowdoku?authSource=meowdoku&tls=true
# Atlas (tạm thời, khi chưa có VPS): mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI="mongodb://127.0.0.1:27017"
MONGODB_DB="meowdoku"

# Upstash Redis (nếu tạo qua Vercel Marketplace thì sẽ có sẵn KV_REST_API_URL / KV_REST_API_TOKEN)
UPSTASH_REDIS_REST_URL="https://xxxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN="..."

# Chuỗi ngẫu nhiên >= 32 ký tự, tạo bằng: openssl rand -base64 48
AUTH_SECRET="..."
